<view><view class="recordList"><block wx:for="{{list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="item"><view class="top"><view class="title">{{item.system_name}}</view><view class="time">{{"提交时间："+item.add_time}}</view><block wx:if="{{item.status==2}}"><view class="reason">{{"原因："+item.fail_msg}}</view></block></view><view class="bottom acea-row row-between-wrapper"><view class="acea-row row-middle"><text class="{{['iconfont',item.status==1?'icon-shenhetongguo':item.status==2?'icon-shenheweitongguo':'icon-daishenhe']}}"></text>{{item.status==1?'审核通过':item.status==2?'审核未通过':'待审核'}}</view><block wx:if="{{item.status==1}}"><view data-event-opts="{{[['tap',[['lookUp',['$0'],[[['list','',index]]]]]]]}}" class="bnt acea-row row-center-wrapper" bindtap="__e">查看</view></block><block wx:else><block wx:if="{{item.status==2}}"><view data-event-opts="{{[['tap',[['resubmit',['$0'],[[['list','',index]]]]]]]}}" class="bnt acea-row row-center-wrapper" bindtap="__e">重新提交</view></block><block wx:else><view data-event-opts="{{[['tap',[['edit',['$0'],[[['list','',index]]]]]]]}}" class="bnt acea-row row-center-wrapper" bindtap="__e">编辑</view></block></block></view></view></block></view><block wx:if="{{$root.g0==0}}"><view class="emptyPage"><empty-page vue-id="7b3502c7-1" title="暂无申请记录~" bind:__l="__l"></empty-page></view></block><block wx:if="{{navigation}}"><home vue-id="7b3502c7-2" bind:__l="__l"></home></block></view>