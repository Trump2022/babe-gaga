<view class="supplierState" style="{{(colorStyle)}}"><view class="pictrue"><block wx:if="{{type==0}}"><image src="{{imgHost+'/statics/images/supplierApplyIng.png'}}"></image></block><block wx:else><block wx:if="{{type==1}}"><image src="{{imgHost+'/statics/images/supplierApplySuccess.png'}}"></image></block><block wx:else><image src="{{imgHost+'/statics/images/supplierApplyFail.png'}}"></image></block></block></view><view class="title">{{type==1?'恭喜，您的申请已通过！':type==2?'您的申请未通过！':'审核中'}}</view><block wx:if="{{type==0}}"><view class="info">您的申请正在审核中，请耐心等待！</view></block><block wx:else><block wx:if="{{type==2}}"><view class="info">请按提示修改您所填写的信息</view></block><block wx:else><view class="webInfor"><view>{{"后台网址："+url}}</view><view class="account">{{"后台账号："+account}}</view><view>{{"登录密码："+pwd}}</view><view><text data-event-opts="{{[['tap',[['copyWb',['$event']]]]]}}" class="copy" bindtap="__e">复制</text></view></view></block></block><block wx:if="{{type==0||type==2}}"><button data-event-opts="{{[['tap',[['edit',['$event']]]]]}}" class="bnt bg-color acea-row row-center-wrapper" bindtap="__e">{{type==0?'修改信息':'重新填写'}}</button></block><button data-event-opts="{{[['tap',[['back',['$event']]]]]}}" class="{{['bnt','on','acea-row','row-center-wrapper',type==1?'ons':'']}}" bindtap="__e">返回上一页</button></view>