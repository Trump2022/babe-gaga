<view class="supplier" style="{{(colorStyle)}}"><view class="conters"><view class="header"><image src="{{picUrl}}"></image><view data-event-opts="{{[['tap',[['record',['$event']]]]]}}" class="record acea-row row-center-wrapper" bindtap="__e">申请记录<text class="iconfont icon-gengduo3"></text></view></view><form data-event-opts="{{[['submit',[['formSubmit',['$event']]]]]}}" bindsubmit="__e"><view class="list"><view class="item acea-row row-between row-bottom"><view>供应商名称</view><input placeholder="请输入供应商名称" placeholder-class="placeholder" name="system_name" maxlength="20" data-event-opts="{{[['input',[['__set_model',['','system_name','$event',[]]]]]]}}" value="{{system_name}}" bindinput="__e"/></view><view class="item acea-row row-between row-bottom"><view>联系人</view><input placeholder="请输入联系人姓名" placeholder-class="placeholder" name="name" maxlength="10" data-event-opts="{{[['input',[['__set_model',['','name','$event',[]]]]]]}}" value="{{name}}" bindinput="__e"/></view><view class="item acea-row row-between row-bottom"><view>联系电话</view><input placeholder="请输入手机号" placeholder-class="placeholder" name="phone" data-event-opts="{{[['input',[['__set_model',['','phone','$event',[]]]]]]}}" value="{{phone}}" bindinput="__e"/></view><view class="item acea-row row-between row-bottom"><view>验证码</view><view class="itemCon acea-row row-between row-bottom"><input class="code" placeholder="请输入验证码" placeholder-class="placeholder" name="captcha" data-event-opts="{{[['input',[['__set_model',['','captcha','$event',[]]]]]]}}" value="{{captcha}}" bindinput="__e"/><button class="{{['bnt','acea-row','row-center-wrapper',disabled===true?'on':'']}}" disabled="{{disabled}}" data-event-opts="{{[['tap',[['code',['$event']]]]]}}" bindtap="__e">{{''+text+''}}</button></view></view><view class="tip">请上传营业执照及行业相关资质证明图片</view><view class="info">(图片最多可上传10张,图片格式支持JPG、PNG、JPEG)</view><view class="picList acea-row row-middle"><block wx:for="{{pics}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block wx:if="{{index<10}}"><view class="pictrue"><image src="{{item}}"></image><text data-event-opts="{{[['tap',[['DelPic',[index]]]]]}}" class="iconfont icon-guanbi1" bindtap="__e"></text></view></block></block><block wx:if="{{$root.g0<10}}"><view data-event-opts="{{[['tap',[['uploadpic',['$event']]]]]}}" class="pictrue acea-row row-center-wrapper row-column" bindtap="__e"><text class="iconfont icon-dizhi-tianjia"></text></view></block></view><view class="protocol"><checkbox-group data-event-opts="{{[['change',[['ChangeIsDefault',['$event']]]]]}}" bindchange="__e"><checkbox class="{{['animated',inAnimation?'headShake':'']}}" checked="{{protocol?true:false}}" data-event-opts="{{[['animationend',[['e0',['$event']]]]]}}" bindanimationend="__e"></checkbox>已阅读并同意<text data-event-opts="{{[['tap',[['getAgreement',['$event']]]]]}}" class="font-color" bindtap="__e">《供应商协议》</text></checkbox-group></view><button class="confirmBnt bg-color" form-type="submit">提交申请</button></view></form></view><agreement class="vue-ref" vue-id="42abfc37-1" showAgree="{{showAgree}}" data-ref="supplier" data-event-opts="{{[['^close',[['close']]]]}}" bind:close="__e" bind:__l="__l"></agreement><block wx:if="{{canvasStatus}}"><canvas style="{{'width:'+(canvasWidth+'px')+';'+('height:'+(canvasHeight+'px')+';')+('position:'+('absolute')+';')+('left:'+('-100000px')+';')+('top:'+('-100000px')+';')}}" canvas-id="canvas"></canvas></block><verify class="vue-ref" vue-id="42abfc37-2" captchaType="blockPuzzle" imgSize="{{({width:'330px',height:'155px'})}}" data-ref="verify" data-event-opts="{{[['^success',[['success']]]]}}" bind:success="__e" bind:__l="__l"></verify><block wx:if="{{navigation}}"><home vue-id="42abfc37-3" bind:__l="__l"></home></block></view>